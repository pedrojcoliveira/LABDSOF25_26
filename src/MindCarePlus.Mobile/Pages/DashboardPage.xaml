<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:MindCarePlus.Mobile.ModelViews"
             x:DataType="viewmodel:DashboardViewModel"
             x:Class="MindCarePlus.Mobile.Pages.DashboardPage"
             xmlns:dto="clr-namespace:MindCarePlus.Shared.DTOs;assembly=MindCarePlus.Shared"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             Title="Dashboard">

    <ContentPage.ToolbarItems>
        <ToolbarItem 
                    Text="Exportar PDF"
                    Command="{Binding ExportarRelatorioPdfCommand}"
                    IconImageSource="share.png"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" BackgroundColor="#6C63FF">

            <!-- Header -->
            <Label Text="{Binding NomeUtilizador, StringFormat='Olá, {0}! 👋'}" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="White"/>

            <Label Text="Bem-vindo ao teu painel de progresso" 
                   FontSize="14" 
                   TextColor="White" 
                   Opacity="0.9"/>

            <!-- Gamificação -->
            <Border BackgroundColor="White" 
                    StrokeShape="RoundRectangle 15"
                    Padding="20" 
                    Shadow="True">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding NivelAtual, StringFormat='Nível {0} - Descobridor'}" 
                               FontSize="18" 
                               FontAttributes="Bold"/>
                        <Border Grid.Column="1" 
                                BackgroundColor="#6C63FF" 
                                StrokeShape="RoundRectangle 25"
                                Padding="15,10" 
                                Shadow="False">
                            <Label Text="{Binding NivelAtual}" 
                                   TextColor="White" 
                                   FontSize="20" 
                                   FontAttributes="Bold"/>
                        </Border>
                    </Grid>

                    <Label Text="{Binding PontosAtuais, StringFormat='Tens {0} pontos'}" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           TextColor="#6C63FF"/>

                    <Label Text="{Binding PontosParaProximoNivel, StringFormat='Faltam {0} pontos para o próximo nível'}" 
                           FontSize="12" 
                           TextColor="Gray"/>   
                    <ProgressBar Progress="{Binding ProgressoPercentagem}" 
                                 ProgressColor="#6C63FF" 
                                 HeightRequest="8"/>

                    <Label Text="{Binding ProgressoPercentagem, StringFormat='{0:P0} completo'}" 
                           FontSize="12" 
                           TextColor="Gray" 
                           HorizontalOptions="End"/>

                    <Grid ColumnDefinitions="*,*,*" 
                          ColumnSpacing="20" 
                          Margin="0,10,0,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="{Binding SequenciaDias}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="#6C63FF" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Sequência" 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="{Binding TotalRegistos}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="#6C63FF" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Registos" 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="5">
                            <Label Text="{Binding TotalBadges}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="#6C63FF" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Badges" 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Evolução de Humor com Gráfico -->
            <Border BackgroundColor="White" 
                    StrokeShape="RoundRectangle 15"
                    Padding="20" 
                    Shadow="True">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding VerGraficoEvolucaoCommand}"/>
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="10">
                    <Label Text="📊 Evolução de Humor - Última Semana" 
                           FontSize="16" 
                           FontAttributes="Bold"/>

                    <microcharts:ChartView Chart="{Binding GraficoHumorDashboard}" 
                                           HeightRequest="180"/>

                    <Label Text="Toca para ver análise detalhada →" 
                           FontSize="11" 
                           TextColor="Gray" 
                           HorizontalOptions="Center"
                           Opacity="0.7"/>
                </VerticalStackLayout>
            </Border>

            <!-- Badges Conquistadas -->
            <Border BackgroundColor="White" 
                    StrokeShape="RoundRectangle 15"
                    Padding="20" 
                    Shadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🏆 Badges Conquistadas" 
                           FontSize="16" 
                           FontAttributes="Bold"/>

                    <ScrollView Orientation="Horizontal" HeightRequest="120">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding BadgesConquistadas}" 
                                               Spacing="15"
                                               Padding="5">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:BadgeConquistadaDto">
                                    <VerticalStackLayout Spacing="8" WidthRequest="70">
                                        <Border BackgroundColor="#FFD700" 
                                                StrokeShape="RoundRectangle 30"
                                                StrokeThickness="0"
                                                WidthRequest="60" 
                                                HeightRequest="60" 
                                                Padding="0"
                                                HorizontalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DashboardViewModel}}, Path=ShowBadgeDetailsCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Border.Shadow>
                                                <Shadow Brush="#FFD700"
                                                        Offset="0,4"
                                                        Radius="8"
                                                        Opacity="0.4"/>
                                            </Border.Shadow>
                                            <Label Text="{Binding ImagemUrl}"
                                                   FontSize="32"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <Label Text="{Binding Nome}" 
                                               FontSize="10" 
                                               TextColor="Gray" 
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap"
                                               MaxLines="2"/>

                                        <Label Text="{Binding Nivel}" 
                                               FontSize="10" 
                                               TextColor="Gray" 
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap"
                                               MaxLines="2"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <!-- Ações Rápidas -->
            <Grid ColumnDefinitions="*,*" 
                  RowDefinitions="Auto,Auto,Auto" 
                  ColumnSpacing="15" 
                  RowSpacing="15">

                <Border Grid.Row="0" Grid.Column="0" 
                        BackgroundColor="White" 
                        StrokeShape="RoundRectangle 15"
                        Padding="20" 
                        Shadow="True">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RegistarHumorCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border BackgroundColor="#6C63FF" 
                                StrokeShape="RoundRectangle 30"
                                WidthRequest="60" 
                                HeightRequest="60" 
                                Padding="0" 
                                HorizontalOptions="Center">
                            <Label Text="😊" 
                                   FontSize="30" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Registar Humor" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"/>
                        <Label Text="Como te sentes hoje?" 
                               FontSize="10" 
                               TextColor="Gray" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" 
                        BackgroundColor="White" 
                        StrokeShape="RoundRectangle 15"
                        Padding="20" 
                        Shadow="True">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VerDesafiosCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border BackgroundColor="#4CAF50" 
                                StrokeShape="RoundRectangle 30"
                                WidthRequest="60" 
                                HeightRequest="60" 
                                Padding="0" 
                                HorizontalOptions="Center">
                            <Label Text="✅" 
                                   FontSize="30" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Desafios Diários" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"/>
                        <Label Text="Realiza os Desafios Diarios" 
                               FontSize="10" 
                               TextColor="Gray" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Relatório IA -->
                <Border BackgroundColor="White"
                        StrokeThickness="1"
                        Stroke="#E5E7EB"
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        Margin="0,0,0,16">

                    <VerticalStackLayout Spacing="16">

                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="🤖" FontSize="24"/>
                                <Label Text="Relatório com IA"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"
                                       VerticalOptions="Center"/>   
                            </HorizontalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Gerar"
                                    Command="{Binding GerarRelatorioIACommand}"
                                    IsVisible="{Binding IsGerarRelatorio, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="#3B82F6"
                                    TextColor="White"
                                    FontSize="12"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Padding="16,0"/>

                            <ActivityIndicator Grid.Column="1"
                                               IsRunning="True"
                                               IsVisible="{Binding IsGerarRelatorio}"
                                               Color="#3B82F6"
                                               HeightRequest="30"
                                               WidthRequest="30"/>  
                        </Grid>

                        <!-- Loading -->
                        <Border IsVisible="{Binding IsGerarRelatorio}"
                                BackgroundColor="#EFF6FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="12">       
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                                <ActivityIndicator IsRunning="True" Color="#3B82F6" HeightRequest="20" WidthRequest="20"/>
                                <Label Text="A gerar relatório com IA..." TextColor="#1E40AF" FontSize="13"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Descrição -->
                        <Label IsVisible="{Binding MostrarRelatorio, Converter={StaticResource InvertedBoolConverter}}"
                               Text="Obtenha insights personalizados sobre o seu estado emocional dos últimos 30 dias."
                               TextColor="#6B7280"
                               FontSize="13"
                               LineBreakMode="WordWrap"/>   

                        <!-- Relatório Expandido -->
                        <VerticalStackLayout IsVisible="{Binding MostrarRelatorio}" Spacing="12">

                            <!-- Header do relatório -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <Label Text="{Binding RelatorioPeriodo}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"
                                       VerticalOptions="Center"/>
                                <Button Grid.Column="1"
                                        Text="✕"
                                        Command="{Binding FecharRelatorioCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="#6B7280"
                                        FontSize="16"
                                        WidthRequest="32"
                                        HeightRequest="32"/>    
                            </Grid>

                            <!-- Médias -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border BackgroundColor="#DBEAFE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="😊" FontSize="18" HorizontalOptions="Center"/>
                                        <Label Text="{Binding RelatorioMediaHumor, StringFormat='{0:F1}'}"
                               FontSize="16" FontAttributes="Bold" TextColor="#1E40AF" HorizontalOptions="Center"/>
                                        <Label Text="Humor" FontSize="9" TextColor="#1E40AF" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1" BackgroundColor="#FEF3C7" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="⚡" FontSize="18" HorizontalOptions="Center"/>
                                        <Label Text="{Binding RelatorioMediaEnergia, StringFormat='{0:F1}'}"
                               FontSize="16" FontAttributes="Bold" TextColor="#92400E" HorizontalOptions="Center"/>
                                        <Label Text="Energia" FontSize="9" TextColor="#92400E" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="2" BackgroundColor="#FCE7F3" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="😰" FontSize="18" HorizontalOptions="Center"/>
                                        <Label Text="{Binding RelatorioMediaStress, StringFormat='{0:F1}'}"
                               FontSize="16" FontAttributes="Bold" TextColor="#BE185D" HorizontalOptions="Center"/>
                                        <Label Text="Stress" FontSize="9" TextColor="#BE185D" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Análise Completa -->
                            <Border BackgroundColor="#F9FAFB" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="📊 Análise do Período"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937"/>    
                                    <Label Text="{Binding RelatorioCompleto}"
                                           FontSize="12"
                                           TextColor="#374151"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Tendências -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="😊 Humor" FontSize="12" FontAttributes="Bold" TextColor="#1E40AF"/>
                                <Label Text="{Binding RelatorioTendenciasHumor}" FontSize="11" TextColor="#374151" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="⚡ Energia" FontSize="12" FontAttributes="Bold" TextColor="#92400E"/>
                                <Label Text="{Binding RelatorioTendenciasEnergia}" FontSize="11" TextColor="#374151" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="😰 Stress" FontSize="12" FontAttributes="Bold" TextColor="#BE185D"/>
                                <Label Text="{Binding RelatorioTendenciasStress}" FontSize="11" TextColor="#374151" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <!-- Recomendações -->
                            <Border BackgroundColor="#F0FDF4" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="💡 Sugestões para si"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#166534"/>
                                    <Label Text="{Binding RelatorioRecomendacoes}"
                                           FontSize="11"
                                           TextColor="#374151"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" 
                        BackgroundColor="White" 
                        StrokeShape="RoundRectangle 15"
                        Padding="20" 
                        Shadow="True">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VerGraficoEvolucaoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border BackgroundColor="#2196F3" 
                                StrokeShape="RoundRectangle 30"
                                WidthRequest="60" 
                                HeightRequest="60" 
                                Padding="0" 
                                HorizontalOptions="Center">
                            <Label Text="📈" 
                                   FontSize="30" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Ver Evolução" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"/>
                        <Label Text="Gráficos detalhados" 
                               FontSize="10" 
                               TextColor="Gray" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" 
                        BackgroundColor="White" 
                        StrokeShape="RoundRectangle 15"
                        Padding="20" 
                        Shadow="True">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ContactarPsicologoCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border BackgroundColor="#9C27B0" 
                                StrokeShape="RoundRectangle 30"
                                WidthRequest="60" 
                                HeightRequest="60" 
                                Padding="0" 
                                HorizontalOptions="Center">
                            <Label Text="💬" 
                                   FontSize="30" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Contactar" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"/>
                        <Label Text="Falar com psicólogo" 
                               FontSize="10" 
                               TextColor="Gray" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" 
                        BackgroundColor="White" 
                        StrokeShape="RoundRectangle 15"
                        Padding="20" 
                        Shadow="True">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirMensagensCommand}"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10">
                        <!-- Ícone com Badge -->
                        <Grid WidthRequest="60" 
                              HeightRequest="60" 
                              HorizontalOptions="Center">

                            <!-- Círculo de fundo -->
                            <Border BackgroundColor="#FF9800" 
                                    StrokeShape="RoundRectangle 30"
                                    WidthRequest="60" 
                                    HeightRequest="60" 
                                    Padding="0">
                                <Label Text="💬" 
                                       FontSize="30" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>

                            <!-- Badge de mensagens não lidas -->
                            <Border BackgroundColor="#EF4444"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="6,3"
                                    IsVisible="{Binding TotalMensagensNaoLidas, Converter={StaticResource IntToBoolConverter}}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="0,-5,-5,0">
                                <Label Text="{Binding TotalMensagensNaoLidas}"
                                       TextColor="White"
                                       FontSize="11"
                                       FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <!-- Título -->
                        <Label Text="Mensagens" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"/>

                        <!-- Subtítulo -->
                        <Label Text="Ver conversas" 
                               FontSize="10" 
                               TextColor="Gray" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>