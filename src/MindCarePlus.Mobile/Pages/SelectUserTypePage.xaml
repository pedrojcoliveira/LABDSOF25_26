<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelViews="clr-namespace:MindCarePlus.Mobile.ModelViews"
             x:Class="MindCarePlus.Mobile.Pages.SelectUserTypePage"
             x:DataType="modelViews:SelectUserTypeViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Logo/Header -->
            <VerticalStackLayout Spacing="10" Margin="0,0,0,40">
                <Label Text="🧠"
                       FontSize="60"
                       HorizontalOptions="Center"/>
                <Label Text="MindCare+"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#6C63FF"/>
                <Label Text="Escolha o tipo de conta"
                       FontSize="18"
                       HorizontalOptions="Center"
                       TextColor="#666666"
                       Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <!-- Card Paciente -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="0"
                    Margin="0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.1"
                            Radius="10"
                            Offset="0,4"/>
                </Border.Shadow>

                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRegisterPacienteCommand}"/>
                    </Grid.GestureRecognizers>

                    <VerticalStackLayout Padding="30" Spacing="15">
                        <Label Text="👤"
                               FontSize="50"
                               HorizontalOptions="Center"/>
                        <Label Text="Sou Paciente"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#333333"/>
                        <Label Text="Procuro apoio psicológico e quero acompanhar o meu bem-estar mental"
                               FontSize="14"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="#666666"
                               LineBreakMode="WordWrap"/>

                        <Button Text="Criar conta de Paciente"
                                BackgroundColor="#6C63FF"
                                TextColor="White"
                                FontAttributes="Bold"
                                Padding="15"
                                Margin="0,10,0,0"
                                CornerRadius="10"
                                Command="{Binding NavigateToRegisterPacienteCommand}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Card Psicólogo -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="0"
                    Margin="0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.1"
                            Radius="10"
                            Offset="0,4"/>
                </Border.Shadow>

                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRegisterPsicologoCommand}"/>
                    </Grid.GestureRecognizers>

                    <VerticalStackLayout Padding="30" Spacing="15">
                        <Label Text="👨‍⚕️"
                               FontSize="50"
                               HorizontalOptions="Center"/>
                        <Label Text="Sou Psicólogo"
                               FontSize="24"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#333333"/>
                        <Label Text="Profissional de saúde mental que deseja acompanhar e apoiar pacientes"
                               FontSize="14"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="#666666"
                               LineBreakMode="WordWrap"/>

                        <Button Text="Criar conta de Psicólogo"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                FontAttributes="Bold"
                                Padding="15"
                                Margin="0,10,0,0"
                                CornerRadius="10"
                                Command="{Binding NavigateToRegisterPsicologoCommand}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Link para Login -->
            <HorizontalStackLayout HorizontalOptions="Center" 
                                   Spacing="5"
                                   Margin="0,20,0,0">
                <Label Text="Já tens uma conta?"
                       TextColor="#666666"
                       FontSize="14"/>
                <Label Text="Entrar"
                       TextColor="#6C63FF"
                       FontSize="14"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>