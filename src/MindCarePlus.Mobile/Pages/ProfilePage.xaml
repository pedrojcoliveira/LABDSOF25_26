<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MindCarePlus.Mobile.ModelViews"
             x:Class="MindCarePlus.Mobile.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Meu Perfil"
             BackgroundColor="#F8FAFC"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="True">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#6366F1</Color>
            <Color x:Key="DangerColor">#EF4444</Color>
            <Color x:Key="DangerDarkColor">#DC2626</Color>
            <Color x:Key="BackgroundColor">#F8FAFC</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="TextPrimaryColor">#1E293B</Color>
            <Color x:Key="TextSecondaryColor">#64748B</Color>
            <Color x:Key="BorderColor">#E2E8F0</Color>
            <Color x:Key="OverlayColor">#80000000</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Conteúdo Principal -->
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource PrimaryColor}"
                                   HeightRequest="50" />

                <!-- Card do Perfil -->
                <Frame BackgroundColor="{StaticResource CardBackgroundColor}"
                       BorderColor="{StaticResource BorderColor}"
                       CornerRadius="16"
                       Padding="20"
                       HasShadow="True"
                       IsVisible="{Binding Profile, Converter={StaticResource IsNotNullConverter}}">

                    <VerticalStackLayout Spacing="16">
                        <!-- Avatar -->
                        <Frame BackgroundColor="{StaticResource PrimaryColor}"
                               WidthRequest="100"
                               HeightRequest="100"
                               CornerRadius="50"
                               HorizontalOptions="Center"
                               Padding="0"
                               HasShadow="False">
                            <Label Text="{Binding Initials}"
                                   FontSize="40"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <!-- Nome -->
                        <Label Text="{Binding Profile.Nome}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimaryColor}"
                               HorizontalTextAlignment="Center" />

                        <!-- Tipo Badge -->
                        <Frame BackgroundColor="{StaticResource PrimaryColor}"
                               Padding="12,6"
                               CornerRadius="20"
                               HorizontalOptions="Center"
                               HasShadow="False">
                            <Label Text="{Binding Profile.TipoUtilizador}"
                                   FontSize="14"
                                   TextColor="White" />
                        </Frame>

                        <!-- Separador -->
                        <BoxView HeightRequest="1" 
                                 Color="{StaticResource BorderColor}"
                                 Margin="0,10" />

                        <!-- Informações -->
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,*,*" RowSpacing="12" ColumnSpacing="16">
                            <!-- Email -->
                            <Label Grid.Row="0" Grid.Column="0" Text="📧" FontSize="20" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Profile.Email}"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center" />

                            <!-- Idade -->
                            <Label Grid.Row="1" Grid.Column="0" Text="🎂" FontSize="20" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding Profile.Idade, StringFormat='{0} anos'}"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center" />

                            <!-- Pontos (Paciente) -->
                            <Label Grid.Row="2" Grid.Column="0" Text="⭐" FontSize="20"
                                   IsVisible="{Binding IsPaciente}" />
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding Profile.Pontos, StringFormat='{0} pontos'}"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsPaciente}" />

                            <!-- Nível (Paciente) -->
                            <Label Grid.Row="3" Grid.Column="0" Text="🏆" FontSize="20"
                                   IsVisible="{Binding IsPaciente}" />
                            <Label Grid.Row="3" Grid.Column="1"
                                   Text="{Binding Profile.NivelGamificacao, StringFormat='Nível {0}'}"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsPaciente}" />

                            <!-- Objectivo (Paciente) -->
                            <Label Grid.Row="4" Grid.Column="0" Text="🎯" FontSize="20"
                                   IsVisible="{Binding IsPaciente}" />
                            <Label Grid.Row="4" Grid.Column="1"
                                   Text="{Binding Profile.Objectivo}"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsPaciente}" />

                            <!-- Especialidade (Psicólogo) -->
                            <Label Grid.Row="2" Grid.Column="0" Text="🩺" FontSize="20"
                                   IsVisible="{Binding IsPsicologo}" />
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding Profile.Especialidade}"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsPsicologo}" />

                            <!-- Cédula (Psicólogo) -->
                            <Label Grid.Row="3" Grid.Column="0" Text="📋" FontSize="20"
                                   IsVisible="{Binding IsPsicologo}" />
                            <Label Grid.Row="3" Grid.Column="1"
                                   Text="{Binding Profile.NumeroCedulaProfissional}"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsPsicologo}" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Botão Editar -->
                <Button Text="✏️ Editar Perfil"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        Command="{Binding EditProfileCommand}" />

                <!-- Botão Logout -->
                <Button Text="🚪 Terminar Sessão"
                        BackgroundColor="{StaticResource TextSecondaryColor}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        Command="{Binding LogoutCommand}" />

                <!-- Separador -->
                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,20" />

                <!-- Zona de Perigo -->
                <Frame BackgroundColor="#FEF2F2"
                       BorderColor="{StaticResource DangerColor}"
                       CornerRadius="12"
                       Padding="16">

                    <VerticalStackLayout Spacing="12">
                        <Label Text="⚠️ Zona de Perigo"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource DangerColor}" />

                        <Label Text="A eliminação da conta é permanente e irreversível. Todos os seus dados serão apagados em conformidade com o GDPR."
                               TextColor="{StaticResource TextSecondaryColor}"
                               FontSize="14" />

                        <Button Text="🗑️ Excluir Conta"
                                BackgroundColor="{StaticResource DangerColor}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                Command="{Binding ShowDeleteConfirmationDialogCommand}" />
                    </VerticalStackLayout>
                </Frame>

                <BoxView HeightRequest="20" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Overlay Confirmação Eliminação -->
        <Grid IsVisible="{Binding ShowDeleteConfirmation}"
              BackgroundColor="{StaticResource OverlayColor}">

            <Frame BackgroundColor="{StaticResource CardBackgroundColor}"
                   CornerRadius="20"
                   Padding="24"
                   Margin="20"
                   VerticalOptions="Center"
                   HorizontalOptions="Fill"
                   HasShadow="True">

                <VerticalStackLayout Spacing="20">
                    <Label Text="⚠️" FontSize="60" HorizontalTextAlignment="Center" />

                    <Label Text="Eliminar Conta"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource DangerColor}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Tem a certeza que deseja eliminar permanentemente a sua conta e todos os dados associados?"
                           TextColor="{StaticResource TextSecondaryColor}"
                           HorizontalTextAlignment="Center"
                           FontSize="16" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Introduza a sua password para confirmar:"
                               TextColor="{StaticResource TextPrimaryColor}"
                               FontSize="14" />

                        <Entry Placeholder="Password"
                               IsPassword="True"
                               Text="{Binding DeletePassword}"
                               BackgroundColor="{StaticResource BackgroundColor}"
                               PlaceholderColor="{StaticResource TextSecondaryColor}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="Cancelar"
                                BackgroundColor="{StaticResource TextSecondaryColor}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                Command="{Binding CancelDeleteCommand}" />

                        <Button Grid.Column="1"
                                Text="Eliminar"
                                BackgroundColor="{StaticResource DangerColor}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold"
                                Command="{Binding ConfirmDeleteAccountCommand}" />
                    </Grid>

                    <ActivityIndicator IsRunning="{Binding IsDeleting}"
                                       IsVisible="{Binding IsDeleting}"
                                       Color="{StaticResource DangerColor}" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
