<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MindCarePlus.Mobile.ModelViews"
             xmlns:dto="clr-namespace:MindCarePlus.Shared.DTOs.Paciente;assembly=MindCarePlus.Shared"
             x:Class="MindCarePlus.Mobile.Pages.DetalhePacientePage"
             x:DataType="vm:DetalhePacienteViewModel"
             Title="{Binding Nome}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="0">

		<!-- Header com Info Básica -->
		<Border Grid.Row="0"
                BackgroundColor="#3B82F6"
                StrokeThickness="0"
                Padding="20"
                Margin="0,0,0,0">

			<VerticalStackLayout Spacing="8">

				<!-- Avatar -->
				<Border WidthRequest="80"
                        HeightRequest="80"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 40"
                        HorizontalOptions="Center">
					<Label Text="{Binding Nome, Converter={StaticResource InicialNomeConverter}}"
                           TextColor="#3B82F6"
                           FontSize="32"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
				</Border>

				<!-- Nome -->
				<Label Text="{Binding Nome}"
                       TextColor="White"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

				<!-- Idade e Nível -->
				<HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
					<Label TextColor="White" FontSize="14" Opacity="0.9">
						<Label.FormattedText>
							<FormattedString>
								<Span Text="{Binding Idade}"/>
								<Span Text=" anos"/>
							</FormattedString>
						</Label.FormattedText>
					</Label>
					<Label Text="•" TextColor="White" FontSize="14" Opacity="0.9"/>
					<Label TextColor="White" FontSize="14" Opacity="0.9">
						<Label.FormattedText>
							<FormattedString>
								<Span Text="Nível "/>
								<Span Text="{Binding NivelGamificacao}"/>
							</FormattedString>
						</Label.FormattedText>
					</Label>
					<Label Text="•" TextColor="White" FontSize="14" Opacity="0.9"/>
					<Label TextColor="White" FontSize="14" Opacity="0.9">
						<Label.FormattedText>
							<FormattedString>
								<Span Text="{Binding Pontos}"/>
								<Span Text=" pts"/>
							</FormattedString>
						</Label.FormattedText>
					</Label>
				</HorizontalStackLayout>

			</VerticalStackLayout>
		</Border>

		<!-- Tabs de Navegação -->
		<Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="0"
                Margin="0">
			<Grid ColumnDefinitions="*,*,*,*" HeightRequest="50">

				<!-- Tab Dados -->
				<Border Grid.Column="0"
                        BackgroundColor="{Binding TabSelecionada, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=0}"
                        StrokeThickness="0,0,0,3"
                        Stroke="{Binding TabSelecionada, Converter={StaticResource TabBorderConverter}, ConverterParameter=0}">
					<Label Text="Dados"
                           TextColor="{Binding TabSelecionada, Converter={StaticResource TabTextColorConverter}, ConverterParameter=0}"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding MostrarDadosCommand}"/>
						</Label.GestureRecognizers>
					</Label>
				</Border>

				<!-- Tab Humor -->
				<Border Grid.Column="1"
                        BackgroundColor="{Binding TabSelecionada, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=1}"
                        StrokeThickness="0,0,0,3"
                        Stroke="{Binding TabSelecionada, Converter={StaticResource TabBorderConverter}, ConverterParameter=1}">
					<Label Text="Humor"
                           TextColor="{Binding TabSelecionada, Converter={StaticResource TabTextColorConverter}, ConverterParameter=1}"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding MostrarHistoricoHumorCommand}"/>
						</Label.GestureRecognizers>
					</Label>
				</Border>

				<!-- Tab Sessões -->
				<Border Grid.Column="2"
                        BackgroundColor="{Binding TabSelecionada, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=2}"
                        StrokeThickness="0,0,0,3"
                        Stroke="{Binding TabSelecionada, Converter={StaticResource TabBorderConverter}, ConverterParameter=2}">
					<Label Text="Sessões"
                           TextColor="{Binding TabSelecionada, Converter={StaticResource TabTextColorConverter}, ConverterParameter=2}"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding MostrarSessoesCommand}"/>
						</Label.GestureRecognizers>
					</Label>
				</Border>

				<!-- Tab Relatórios -->
				<Border Grid.Column="3"
                        BackgroundColor="{Binding TabSelecionada, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=3}"
                        StrokeThickness="0,0,0,3"
                        Stroke="{Binding TabSelecionada, Converter={StaticResource TabBorderConverter}, ConverterParameter=3}">
					<Label Text="Relatórios"
                           TextColor="{Binding TabSelecionada, Converter={StaticResource TabTextColorConverter}, ConverterParameter=3}"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding MostrarRelatoriosCommand}"/>
						</Label.GestureRecognizers>
					</Label>
				</Border>

			</Grid>
		</Border>

		<!-- Conteúdo dos Tabs -->
		<ScrollView Grid.Row="2">

			<VerticalStackLayout Padding="16" Spacing="16">

				<!-- Loading -->
				<ActivityIndicator IsRunning="{Binding IsLoading}"
                                 IsVisible="{Binding IsLoading}"
                                 Color="#3B82F6"
                                 HeightRequest="50"/>

				<!-- Erro -->
				<Border IsVisible="{Binding MensagemErro, Converter={StaticResource StringNotEmptyConverter}}"
                        BackgroundColor="#FEE2E2"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
					<Label Text="{Binding MensagemErro}"
                           TextColor="#991B1B"
                           FontSize="14"/>
				</Border>

				<!-- TAB 0: Dados Pessoais -->
				<VerticalStackLayout Spacing="12" IsVisible="{Binding TabSelecionada, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}">

					<Label Text="Informações Pessoais"
                           TextColor="#1F2937"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,8,0,8"/>

					<Border BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
						<VerticalStackLayout Spacing="12">

							<Grid ColumnDefinitions="Auto,*">
								<Label Grid.Column="0" Text="Email:" TextColor="#6B7280" FontSize="14" FontAttributes="Bold"/>
								<Label Grid.Column="1" Text="{Binding Email}" TextColor="#1F2937" FontSize="14" Margin="8,0,0,0"/>
							</Grid>

							<BoxView HeightRequest="1" Color="#E5E7EB"/>

							<Grid ColumnDefinitions="Auto,*">
								<Label Grid.Column="0" Text="Objectivo:" TextColor="#6B7280" FontSize="14" FontAttributes="Bold"/>
								<Label Grid.Column="1" Text="{Binding Objectivo}" TextColor="#1F2937" FontSize="14" Margin="8,0,0,0"/>
							</Grid>

							<BoxView HeightRequest="1" Color="#E5E7EB"/>

							<Grid ColumnDefinitions="Auto,*">
								<Label Grid.Column="0" Text="Registo:" TextColor="#6B7280" FontSize="14" FontAttributes="Bold"/>
								<Label Grid.Column="1" Text="{Binding DataRegisto, StringFormat='{0:dd/MM/yyyy}'}" TextColor="#1F2937" FontSize="14" Margin="8,0,0,0"/>
							</Grid>

						</VerticalStackLayout>
					</Border>

					<Label Text="Estatísticas"
                           TextColor="#1F2937"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,16,0,8"/>

					<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="12" ColumnSpacing="12">

						<!-- Total Registos -->
						<Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="#DBEAFE"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="16">
							<VerticalStackLayout Spacing="4">
								<Label Text="{Binding TotalRegistos}"
                                       TextColor="#1E40AF"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
								<Label Text="Registos"
                                       TextColor="#1E40AF"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
							</VerticalStackLayout>
						</Border>

						<!-- Total Sessões -->
						<Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="#D1FAE5"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="16">
							<VerticalStackLayout Spacing="4">
								<Label Text="{Binding TotalSessoes}"
                                       TextColor="#065F46"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
								<Label Text="Sessões"
                                       TextColor="#065F46"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
							</VerticalStackLayout>
						</Border>

						<!-- Dias Consecutivos -->
						<Border Grid.Row="0" Grid.Column="2"
                                BackgroundColor="#FEF3C7"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="16">
							<VerticalStackLayout Spacing="4">
								<Label Text="{Binding DiasConsecutivos}"
                                       TextColor="#92400E"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
								<Label Text="Dias"
                                       TextColor="#92400E"
                                       FontSize="12"
                                       HorizontalOptions="Center"/>
							</VerticalStackLayout>
						</Border>

						<!-- Média Humor -->
						<Border Grid.Row="1" Grid.Column="0"
                                BackgroundColor="White"
                                StrokeThickness="1"
                                Stroke="#E5E7EB"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">
							<VerticalStackLayout Spacing="2">
								<Label Text="{Binding MediaHumor, StringFormat='{0:F1}'}"
                                       TextColor="#1F2937"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
								<Label Text="Média Humor"
                                       TextColor="#6B7280"
                                       FontSize="11"
                                       HorizontalOptions="Center"/>
							</VerticalStackLayout>
						</Border>

						<!-- Média Stress -->
						<Border Grid.Row="1" Grid.Column="1"
                                BackgroundColor="White"
                                StrokeThickness="1"
                                Stroke="#E5E7EB"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">
							<VerticalStackLayout Spacing="2">
								<Label Text="{Binding MediaStress, StringFormat='{0:F1}'}"
                                       TextColor="#1F2937"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
								<Label Text="Média Stress"
                                       TextColor="#6B7280"
                                       FontSize="11"
                                       HorizontalOptions="Center"/>
							</VerticalStackLayout>
						</Border>

						<!-- Média Energia -->
						<Border Grid.Row="1" Grid.Column="2"
                                BackgroundColor="White"
                                StrokeThickness="1"
                                Stroke="#E5E7EB"
                                StrokeShape="RoundRectangle 12"
                                Padding="12">
							<VerticalStackLayout Spacing="2">
								<Label Text="{Binding MediaEnergia, StringFormat='{0:F1}'}"
                                       TextColor="#1F2937"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
								<Label Text="Média Energia"
                                       TextColor="#6B7280"
                                       FontSize="11"
                                       HorizontalOptions="Center"/>
							</VerticalStackLayout>
						</Border>

					</Grid>

				</VerticalStackLayout>

				<!-- TAB 1: Histórico de Humor -->
				<VerticalStackLayout Spacing="12" IsVisible="{Binding TabSelecionada, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}">

					<Label Text="Histórico de Humor (30 dias)"
                           TextColor="#1F2937"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,8,0,8"/>

					<CollectionView ItemsSource="{Binding HistoricoHumor}"
                                  SelectionMode="None">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="dto:RegistoHumorDto">
								<Border BackgroundColor="White"
                                        StrokeThickness="1"
                                        Stroke="#E5E7EB"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="16"
                                        Margin="0,0,0,12">

									<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">

										<!-- Data -->
										<Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding DataRegisto, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                               TextColor="#6B7280"
                                               FontSize="12"
                                               Margin="0,0,0,8"/>

										<!-- Níveis -->
										<VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
											<HorizontalStackLayout Spacing="8">
												<Label Text="😊" FontSize="16"/>
												<Label Text="Humor:" TextColor="#6B7280" FontSize="14"/>
												<Label Text="{Binding NivelHumor}" TextColor="#1F2937" FontSize="14" FontAttributes="Bold"/>
											</HorizontalStackLayout>

											<HorizontalStackLayout Spacing="8">
												<Label Text="😰" FontSize="16"/>
												<Label Text="Stress:" TextColor="#6B7280" FontSize="14"/>
												<Label Text="{Binding NivelStress}" TextColor="#1F2937" FontSize="14" FontAttributes="Bold"/>
											</HorizontalStackLayout>

											<HorizontalStackLayout Spacing="8">
												<Label Text="⚡" FontSize="16"/>
												<Label Text="Energia:" TextColor="#6B7280" FontSize="14"/>
												<Label Text="{Binding NivelEnergia}" TextColor="#1F2937" FontSize="14" FontAttributes="Bold"/>
											</HorizontalStackLayout>
										</VerticalStackLayout>

										<!-- Notas -->
										<Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Notas}"
                                               TextColor="#4B5563"
                                               FontSize="13"
                                               Margin="0,8,0,0"
                                               IsVisible="{Binding Notas, Converter={StaticResource StringNotEmptyConverter}}"/>

									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>

					<!-- Mensagem Vazia -->
					<Label Text="Sem registos de humor nos últimos 30 dias."
                           TextColor="#9CA3AF"
                           FontSize="14"
                           HorizontalOptions="Center"
                           Margin="0,32,0,0"
                           IsVisible="{Binding TemHistorico, Converter={StaticResource InvertedBoolConverter}}"/>

				</VerticalStackLayout>

				<!-- TAB 2: Sessões -->
				<VerticalStackLayout Spacing="12" IsVisible="{Binding TabSelecionada, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}">

					<Label Text="Sessões Realizadas"
                           TextColor="#1F2937"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,8,0,8"/>

					<CollectionView ItemsSource="{Binding Sessoes}"
                                  SelectionMode="None">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="dto:SessaoResumoDto">
								<Border BackgroundColor="White"
                                        StrokeThickness="1"
                                        Stroke="#E5E7EB"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="16"
                                        Margin="0,0,0,12">

									<Border.GestureRecognizers>
										<TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DetalhePacienteViewModel}}, Path=VerDetalhesSessaoCommand}"
                                            CommandParameter="{Binding .}"/>
									</Border.GestureRecognizers>

									<Grid ColumnDefinitions="*,Auto">
										<VerticalStackLayout Grid.Column="0" Spacing="4">
											<Label Text="{Binding DataSessao, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                                   TextColor="#1F2937"
                                                   FontSize="14"
                                                   FontAttributes="Bold"/>
											<Label TextColor="#6B7280" FontSize="13">
												<Label.FormattedText>
													<FormattedString>
														<Span Text="Duração: "/>
														<Span Text="{Binding Duracao}"/>
														<Span Text=" min"/>
													</FormattedString>
												</Label.FormattedText>
											</Label>
											<Label IsVisible="{Binding Avaliada}">
												<Label.FormattedText>
													<FormattedString>
														<Span Text="⭐ " FontSize="12"/>
														<Span Text="{Binding NotaAvaliacao}" FontSize="12"/>
														<Span Text="/5" FontSize="12"/>
													</FormattedString>
												</Label.FormattedText>
											</Label>
										</VerticalStackLayout>

										<Label Grid.Column="1" Text="›" TextColor="#9CA3AF" FontSize="20" VerticalOptions="Center"/>
									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>

					<!-- Mensagem Vazia -->
					<Label Text="Ainda não foram realizadas sessões com este paciente."
                           TextColor="#9CA3AF"
                           FontSize="14"
                           HorizontalOptions="Center"
                           Margin="0,32,0,0"
                           IsVisible="{Binding TemSessoes, Converter={StaticResource InvertedBoolConverter}}"/>

				</VerticalStackLayout>

				<!-- TAB 3: Relatórios IA -->
				<VerticalStackLayout Spacing="12" IsVisible="{Binding TabSelecionada, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}">

					<Label Text="Relatórios Gerados pela IA"
                           TextColor="#1F2937"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,8,0,8"/>

					<CollectionView ItemsSource="{Binding RelatoriosIA}"
                                  SelectionMode="None">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="dto:RelatorioIAResumoDto">
								<Border BackgroundColor="White"
                                        StrokeThickness="1"
                                        Stroke="#E5E7EB"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="16"
                                        Margin="0,0,0,12">

									<Border.GestureRecognizers>
										<TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DetalhePacienteViewModel}}, Path=VerDetalhesRelatorioCommand}"
                                            CommandParameter="{Binding .}"/>
									</Border.GestureRecognizers>

									<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
										<Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding TipoRelatorio}"
                                               TextColor="#1F2937"
                                               FontSize="14"
                                               FontAttributes="Bold"/>

										<Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding DataGeracao, StringFormat='{0:dd/MM/yyyy}'}"
                                               TextColor="#6B7280"
                                               FontSize="12"
                                               Margin="0,4,0,4"/>

										<Border Grid.Row="2" Grid.Column="0"
                                                BackgroundColor="{Binding NivelAlerta, Converter={StaticResource AlertaToColorConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="8,4"
                                                HorizontalOptions="Start">
											<Label Text="{Binding NivelAlerta}"
                                                   TextColor="White"
                                                   FontSize="11"
                                                   FontAttributes="Bold"/>
										</Border>

										<Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                               Text="›"
                                               TextColor="#9CA3AF"
                                               FontSize="20"
                                               VerticalOptions="Center"/>
									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>

					<!-- Mensagem Vazia -->
					<Label Text="Ainda não foram gerados relatórios pela IA para este paciente."
                           TextColor="#9CA3AF"
                           FontSize="14"
                           HorizontalOptions="Center"
                           Margin="0,32,0,0"
                           IsVisible="{Binding TemRelatorios, Converter={StaticResource InvertedBoolConverter}}"/>

				</VerticalStackLayout>

			</VerticalStackLayout>

		</ScrollView>

	</Grid>

</ContentPage>