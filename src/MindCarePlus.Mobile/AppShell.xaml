<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MindCarePlus.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MindCarePlus.Mobile"
    xmlns:pages="clr-namespace:MindCarePlus.Mobile.Pages"
    Title="MindCarePlus">

    <TabBar>
        <ShellContent
            Title="Início"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Humor"
            ContentTemplate="{DataTemplate pages:RegistoHumorPage}"
            Route="RegistoHumor" />
    </TabBar>

</Shell>