<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MindCarePlus.Mobile"
             xmlns:converters="clr-namespace:MindCarePlus.Mobile.Converters"
             x:Class="MindCarePlus.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:IntToBorderColorConverter x:Key="IntToBorderColorConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:EstadoToBorderColorConverter x:Key="EstadoToBorderColorConverter" />
            <converters:EstadoToButtonTextConverter x:Key="EstadoToButtonTextConverter" />
            <converters:EstadoToButtonColorConverter x:Key="EstadoToButtonColorConverter" />
            <converters:EstadoToButtonEnabledConverter x:Key="EstadoToButtonEnabledConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>